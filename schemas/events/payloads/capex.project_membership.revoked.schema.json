{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capex.project_membership.revoked",
  "type": "object",
  "required": [
    "project_membership_id",
    "project_id",
    "actor_id",
    "actor_type",
    "previous_role",
    "state",
    "revoked_by_actor_id",
    "revoked_by_actor_type"
  ],
  "properties": {
    "project_membership_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_type": {
      "type": "string",
      "enum": [
        "human",
        "agent",
        "service",
        "system"
      ]
    },
    "previous_role": {
      "type": "string",
      "enum": [
        "project_viewer",
        "project_contributor",
        "project_admin"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "revoked"
      ]
    },
    "revoked_by_actor_id": {
      "type": "string"
    },
    "revoked_by_actor_type": {
      "type": "string",
      "enum": [
        "human",
        "agent",
        "service",
        "system"
      ]
    }
  },
  "additionalProperties": false
}
