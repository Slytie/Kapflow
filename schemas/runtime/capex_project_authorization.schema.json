{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapexProjectAuthorization",
  "type": "object",
  "required": [
    "project_authorization_id",
    "project_id",
    "tenant_id",
    "domain_id",
    "actor_type",
    "actor_id",
    "direct_role",
    "effective_role",
    "source_membership_id",
    "state",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "project_authorization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "domain_id": {
      "type": "string"
    },
    "actor_type": {
      "type": "string",
      "enum": ["human", "agent", "service", "system"]
    },
    "actor_id": {
      "type": "string"
    },
    "direct_role": {
      "type": "string",
      "enum": ["project_viewer", "project_contributor", "project_admin"]
    },
    "effective_role": {
      "type": "string",
      "enum": ["project_viewer", "project_contributor", "project_admin"]
    },
    "source_membership_id": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": ["active"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
