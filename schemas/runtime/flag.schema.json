{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flag",
  "type": "object",
  "required": [
    "flag_id",
    "tenant_id",
    "domain_id",
    "workflow_id",
    "partition_key",
    "kind",
    "state",
    "severity",
    "created_at",
    "created_by"
  ],
  "properties": {
    "flag_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "domain_id": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string"
    },
    "partition_key": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "triage",
        "blocked",
        "resolved",
        "closed",
        "waived"
      ]
    },
    "summary": {
      "type": "string"
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_by": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "service",
            "system"
          ]
        },
        "id": {
          "type": "string"
        },
        "display": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "assigned_group": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "id"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
