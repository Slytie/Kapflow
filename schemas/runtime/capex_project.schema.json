{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapexProject",
  "type": "object",
  "required": [
    "project_id",
    "tenant_id",
    "domain_id",
    "project_key",
    "name",
    "state",
    "metadata_json",
    "created_by_actor_id",
    "created_by_actor_type",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "domain_id": {
      "type": "string"
    },
    "project_key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ]
    },
    "metadata_json": {
      "type": "object"
    },
    "created_by_actor_id": {
      "type": "string"
    },
    "created_by_actor_type": {
      "type": "string",
      "enum": [
        "human",
        "agent",
        "service",
        "system"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
