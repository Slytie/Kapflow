{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapexClosureSnapshot",
  "type": "object",
  "required": [
    "closure_snapshot_id",
    "closure_gate_evaluation_id",
    "tenant_id",
    "domain_id",
    "closure_target_kind",
    "closure_target_ref",
    "policy_version",
    "state",
    "result",
    "basis_version_vector_json",
    "metadata_json",
    "created_by_actor_id",
    "created_by_actor_type",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "closure_snapshot_id": { "type": "string" },
    "closure_gate_evaluation_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "domain_id": { "type": "string" },
    "project_id": { "type": ["string", "null"] },
    "closure_target_kind": { "type": "string" },
    "closure_target_ref": { "type": "string" },
    "policy_version": { "type": "string" },
    "state": {
      "type": "string",
      "enum": ["current", "stale", "reopened"]
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail", "satisfied_by_waiver"]
    },
    "basis_version_vector_json": { "type": "object" },
    "metadata_json": { "type": "object" },
    "created_by_actor_id": { "type": "string" },
    "created_by_actor_type": {
      "type": "string",
      "enum": ["human", "agent", "service", "system"]
    },
    "stale_reason": { "type": ["string", "null"] },
    "stale_at": { "type": ["string", "null"], "format": "date-time" },
    "reopened_at": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
