{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapexWorkflowHandoffManifest",
  "type": "object",
  "required": [
    "manifest_id",
    "schema_version",
    "tenant_id",
    "domain_id",
    "source_workflow_run_id",
    "target_workflow_id",
    "target_workflow_version",
    "target_partition_key",
    "artifact_versions",
    "pointers",
    "source_refs",
    "validation_summaries",
    "closure_gate_evaluation_ids",
    "closure_snapshot_ids",
    "task_handoff_bindings",
    "workpage_handoff_bindings",
    "basis_version_vector_json",
    "metadata_json"
  ],
  "properties": {
    "manifest_id": { "type": "string" },
    "schema_version": { "type": "string", "const": "capex.workflow_handoff_manifest.v1" },
    "tenant_id": { "type": "string" },
    "domain_id": { "type": "string" },
    "project_id": { "type": ["string", "null"] },
    "source_workflow_run_id": { "type": "string" },
    "target_workflow_id": { "type": "string" },
    "target_workflow_version": { "type": "string" },
    "target_partition_key": { "type": "string" },
    "artifact_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_version_id", "artifact_kind", "content_digest"],
        "properties": {
          "artifact_version_id": { "type": "string" },
          "artifact_kind": { "type": "string" },
          "content_digest": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "pointers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pointer_id", "pointer_key", "artifact_version_id", "generation"],
        "properties": {
          "pointer_id": { "type": "string" },
          "pointer_key": { "type": "string" },
          "artifact_version_id": { "type": "string" },
          "generation": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^source_occurrence:[^\\s]+$"
      }
    },
    "validation_summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["validation_id", "result"],
        "properties": {
          "validation_id": { "type": "string" },
          "result": {
            "type": "string",
            "enum": ["pass", "satisfied_by_waiver"]
          },
          "summary": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "closure_gate_evaluation_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "closure_snapshot_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "task_handoff_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["binding_id", "task_kind", "basis_ref"],
        "properties": {
          "binding_id": { "type": "string" },
          "task_kind": { "type": "string" },
          "basis_ref": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "workpage_handoff_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["binding_id", "workpage_kind", "basis_ref"],
        "properties": {
          "binding_id": { "type": "string" },
          "workpage_kind": { "type": "string" },
          "basis_ref": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "basis_version_vector_json": {
      "type": "object",
      "required": ["basis_refs"],
      "properties": {
        "basis_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "metadata_json": { "type": "object" }
  },
  "additionalProperties": false
}
