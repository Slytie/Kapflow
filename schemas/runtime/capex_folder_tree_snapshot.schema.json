{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapexFolderTreeSnapshot",
  "type": "object",
  "required": [
    "folder_tree_snapshot_id",
    "source_root_id",
    "sync_run_id",
    "tenant_id",
    "domain_id",
    "project_id",
    "observation_basis",
    "path_scope",
    "status",
    "metadata_json",
    "created_by_actor_id",
    "created_by_actor_type",
    "observed_at",
    "created_at"
  ],
  "properties": {
    "folder_tree_snapshot_id": { "type": "string" },
    "source_root_id": { "type": "string" },
    "sync_run_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "domain_id": { "type": "string" },
    "project_id": { "type": "string" },
    "observation_basis": { "type": "string" },
    "path_scope": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["complete", "partial", "failed", "degraded"]
    },
    "manifest_digest": { "type": ["string", "null"] },
    "file_count": { "type": ["integer", "null"], "minimum": 0 },
    "metadata_json": { "type": "object" },
    "created_by_actor_id": { "type": "string" },
    "created_by_actor_type": {
      "type": "string",
      "enum": ["human", "agent", "service", "system"]
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
