{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowLabRunProfile",
  "type": "object",
  "required": [
    "profile_id",
    "profile_kind"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_kind": {
      "type": "string",
      "minLength": 1
    },
    "time_scope": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "budget_class": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
