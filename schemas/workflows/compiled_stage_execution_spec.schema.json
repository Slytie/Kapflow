{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompiledStageExecutionSpec",
  "type": "object",
  "required": [
    "family_id",
    "family_version",
    "module_id",
    "workflow_id",
    "stage_id",
    "execution_pattern",
    "module_partition_kind",
    "module_activation_policy",
    "module_status",
    "stage_control_digest",
    "required_input_dataset_keys",
    "required_evidence_keys",
    "decision_refs",
    "method_package_pin",
    "runtime_bindings"
  ],
  "properties": {
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "family_version": {
      "type": "integer",
      "minimum": 1
    },
    "module_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_pattern": {
      "type": "string",
      "enum": [
        "linear_chain",
        "approval_gate",
        "bounded_exception_loop"
      ]
    },
    "module_partition_kind": {
      "type": "string",
      "enum": [
        "AvailabilityRequestID",
        "PlanningWeekID",
        "ServiceDateID",
        "PayPeriodID",
        "ScheduleDateID"
      ]
    },
    "module_activation_policy": {
      "type": "string",
      "enum": [
        "long_lived_case_per_partition",
        "lazy_on_event",
        "manual_only"
      ]
    },
    "module_status": {
      "type": "string",
      "enum": [
        "first_slice",
        "extension",
        "deferred"
      ]
    },
    "stage_control_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "required_input_dataset_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_evidence_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "method_package_pin": {
      "type": "object",
      "required": [
        "method_package_id",
        "method_package_version",
        "method_package_digest",
        "context_builder_ref",
        "tool_profile_ref",
        "output_schema_ref",
        "lowering_rule_ref",
        "stop_policy",
        "replay_policy"
      ],
      "properties": {
        "method_package_id": {
          "type": "string",
          "minLength": 1
        },
        "method_package_version": {
          "type": "integer",
          "minimum": 1
        },
        "method_package_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "context_builder_ref": {
          "type": "string",
          "minLength": 1
        },
        "tool_profile_ref": {
          "type": "string",
          "minLength": 1
        },
        "output_schema_ref": {
          "type": "string",
          "minLength": 1
        },
        "lowering_rule_ref": {
          "type": "string",
          "minLength": 1
        },
        "stop_policy": {
          "type": "object",
          "required": [
            "max_tool_calls",
            "no_progress_ticks",
            "on_exhaustion"
          ],
          "properties": {
            "max_tool_calls": {
              "type": "integer",
              "minimum": 0
            },
            "no_progress_ticks": {
              "type": "integer",
              "minimum": 0
            },
            "on_exhaustion": {
              "type": "string",
              "enum": [
                "escalate",
                "wait_for_human",
                "fail",
                "terminate"
              ]
            }
          },
          "additionalProperties": false
        },
        "replay_policy": {
          "type": "object",
          "required": [
            "deterministic_fields",
            "allow_optional_llm_rationale"
          ],
          "properties": {
            "deterministic_fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allow_optional_llm_rationale": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runtime_bindings": {
      "type": "object",
      "required": [
        "workflow_run",
        "task_run",
        "human_task",
        "execution_session",
        "tool_execution"
      ],
      "properties": {
        "workflow_run": {
          "type": "object",
          "required": [
            "object_type",
            "partition_kind",
            "activation_policy"
          ],
          "properties": {
            "object_type": {
              "type": "string",
              "const": "workflow_run"
            },
            "partition_kind": {
              "type": "string",
              "enum": [
                "AvailabilityRequestID",
                "PlanningWeekID",
                "ServiceDateID",
                "PayPeriodID",
                "ScheduleDateID"
              ]
            },
            "activation_policy": {
              "type": "string",
              "enum": [
                "long_lived_case_per_partition",
                "lazy_on_event",
                "manual_only"
              ]
            }
          },
          "additionalProperties": false
        },
        "task_run": {
          "type": "object",
          "required": [
            "object_type",
            "stage_id",
            "task_kind_default",
            "owner_mode"
          ],
          "properties": {
            "object_type": {
              "type": "string",
              "const": "task_run"
            },
            "stage_id": {
              "type": "string",
              "minLength": 1
            },
            "task_kind_default": {
              "type": "string",
              "minLength": 1
            },
            "owner_mode": {
              "type": "string",
              "enum": [
                "human",
                "agent",
                "service",
                "mixed"
              ]
            }
          },
          "additionalProperties": false
        },
        "human_task": {
          "type": "object",
          "required": [
            "object_type",
            "required"
          ],
          "properties": {
            "object_type": {
              "type": "string",
              "const": "human_task"
            },
            "required": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "execution_session": {
          "type": "object",
          "required": [
            "object_type",
            "execution_spec_id",
            "owner_mode",
            "max_tool_calls",
            "no_progress_ticks",
            "on_exhaustion"
          ],
          "properties": {
            "object_type": {
              "type": "string",
              "const": "execution_session"
            },
            "execution_spec_id": {
              "type": "string",
              "minLength": 1
            },
            "owner_mode": {
              "type": "string",
              "enum": [
                "human",
                "agent",
                "service",
                "mixed"
              ]
            },
            "max_tool_calls": {
              "type": "integer",
              "minimum": 0
            },
            "no_progress_ticks": {
              "type": "integer",
              "minimum": 0
            },
            "on_exhaustion": {
              "type": "string",
              "enum": [
                "escalate",
                "wait_for_human",
                "fail",
                "terminate"
              ]
            }
          },
          "additionalProperties": false
        },
        "tool_execution": {
          "type": "object",
          "required": [
            "object_type",
            "allowed_tool_classes",
            "side_effect_policy"
          ],
          "properties": {
            "object_type": {
              "type": "string",
              "const": "tool_execution"
            },
            "allowed_tool_classes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "side_effect_policy": {
              "type": "string",
              "enum": [
                "none",
                "draft_only",
                "commit_requires_business_decision",
                "commit_requires_conditional_business_decision",
                "commit_requires_execution_gate"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
