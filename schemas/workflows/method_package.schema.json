{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MethodPackageRegistry",
  "type": "object",
  "required": [
    "registry"
  ],
  "properties": {
    "registry": {
      "type": "object",
      "required": [
        "id",
        "version",
        "packages"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/method_package"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "method_package": {
      "type": "object",
      "required": [
        "id",
        "version",
        "applies_to",
        "execution_pattern",
        "context_builder_ref",
        "tool_profile_ref",
        "output_schema_ref",
        "lowering_rule_ref",
        "stop_policy",
        "replay_policy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "applies_to": {
          "type": "object",
          "required": [
            "workflow_id",
            "stage_id"
          ],
          "properties": {
            "workflow_id": {
              "type": "string",
              "minLength": 1
            },
            "stage_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "execution_pattern": {
          "type": "string",
          "enum": [
            "linear_chain",
            "approval_gate",
            "bounded_exception_loop"
          ]
        },
        "context_builder_ref": {
          "type": "string",
          "minLength": 1
        },
        "tool_profile_ref": {
          "type": "string",
          "minLength": 1
        },
        "output_schema_ref": {
          "type": "string",
          "minLength": 1
        },
        "lowering_rule_ref": {
          "type": "string",
          "minLength": 1
        },
        "stop_policy": {
          "type": "object",
          "required": [
            "max_tool_calls",
            "no_progress_ticks",
            "on_exhaustion"
          ],
          "properties": {
            "max_tool_calls": {
              "type": "integer",
              "minimum": 0
            },
            "no_progress_ticks": {
              "type": "integer",
              "minimum": 0
            },
            "on_exhaustion": {
              "type": "string",
              "enum": [
                "escalate",
                "wait_for_human",
                "fail",
                "terminate"
              ]
            }
          },
          "additionalProperties": false
        },
        "replay_policy": {
          "type": "object",
          "required": [
            "deterministic_fields",
            "allow_optional_llm_rationale"
          ],
          "properties": {
            "deterministic_fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allow_optional_llm_rationale": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
