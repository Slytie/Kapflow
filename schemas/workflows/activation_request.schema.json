{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActivationRequest",
  "type": "object",
  "required": [
    "activation_request"
  ],
  "properties": {
    "activation_request": {
      "type": "object",
      "required": [
        "request_id",
        "family_id",
        "target_module_id",
        "target_partition",
        "trigger",
        "required_inputs",
        "governance_context",
        "idempotency_key"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "family_id": {
          "type": "string",
          "minLength": 1
        },
        "target_module_id": {
          "type": "string",
          "minLength": 1
        },
        "target_stage_id": {
          "type": "string",
          "minLength": 1
        },
        "target_partition": {
          "type": "object",
          "required": [
            "kind",
            "key"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "AvailabilityRequestID",
                "PlanningWeekID",
                "ServiceDateID",
                "PayPeriodID",
                "ScheduleDateID"
              ]
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "trigger": {
          "type": "object",
          "required": [
            "kind",
            "source_ref"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "seed_only",
                "event",
                "handoff",
                "manual",
                "handoff_plus_event"
              ]
            },
            "source_ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "required_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "binding_key",
              "state_ref",
              "expected_generation"
            ],
            "properties": {
              "binding_key": {
                "type": "string",
                "minLength": 1
              },
              "state_ref": {
                "type": "object",
                "required": [
                  "kind",
                  "pointer_id"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "registry"
                  },
                  "pointer_id": {
                    "type": "string",
                    "pattern": "^ptr/v1/.+"
                  }
                },
                "additionalProperties": false
              },
              "expected_generation": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "governance_context": {
          "type": "object",
          "required": [
            "tenant_id",
            "domain_id",
            "actor_type",
            "actor_id"
          ],
          "properties": {
            "tenant_id": {
              "type": "string",
              "minLength": 1
            },
            "domain_id": {
              "type": "string",
              "minLength": 1
            },
            "initiating_workflow_run_id": {
              "type": "string",
              "minLength": 1
            },
            "actor_type": {
              "type": "string",
              "enum": [
                "human",
                "agent",
                "service",
                "system"
              ]
            },
            "actor_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
