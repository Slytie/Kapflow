{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapflow.local/schemas/ops/backup_manifest.schema.json",
  "title": "Predeploy backup manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "command",
    "generated_at",
    "mode",
    "environment",
    "state_copy_performed",
    "restore_proof",
    "db",
    "artifact_root",
    "release",
    "secret_refs"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "command": {
      "const": "predeploy.backup_manifest.prepare"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "validate_only"
    },
    "environment": {
      "enum": ["lab", "prod"]
    },
    "state_copy_performed": {
      "const": false
    },
    "restore_proof": {
      "const": false
    },
    "db": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "path", "size_bytes", "sha256"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^sqlite:///"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256_hex"
        }
      }
    },
    "artifact_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_count", "total_size_bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "manifest_sha256",
        "git_commit",
        "release_source_bundle_path",
        "release_source_bundle_sha256",
        "image_digest_ref"
      ],
      "properties": {
        "manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256_hex"
        },
        "git_commit": {
          "type": "string",
          "minLength": 7
        },
        "release_source_bundle_path": {
          "type": "string",
          "minLength": 1
        },
        "release_source_bundle_sha256": {
          "$ref": "#/$defs/sha256_hex"
        },
        "image_digest_ref": {
          "type": "string",
          "pattern": "@sha256:[0-9a-f]{64}$"
        }
      }
    },
    "secret_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
