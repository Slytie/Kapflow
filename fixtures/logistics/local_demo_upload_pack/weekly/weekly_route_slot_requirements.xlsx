  "example_id": "weekly_stage04_actual_ops_lab_v3",
  "operational_week_start": "2026-03-22",
  "planner_notes": [
    "Route counts for 2026-03-22..2026-03-28 come only from Schedule March 22 to March 28.pdf.",
    "Staffing cells, staffing patterns, and richer route mix data from that holdout schedule are intentionally excluded from this lab-normalized package.",
    "The deterministic planner should cover required routes first, then fill at least three On-Call buffer positions per day where legal, prefer four, and stop before five when added reserve would worsen work balance, trigger avoidable churn, or create 5th-placement overtime.",
    "After route coverage and On-Call filling, the deterministic planner should fill at least two excess-capacity baseline shifts per day where legal, prefer three, and stop before five when stronger work-balance priorities would be harmed.",
    "Weekly target shifts and rolling 7 / weekly cap defaults from the compatibility package are heuristic guidance for this pilot package; explicit availability, eligibility, locks, and named restrictions remain authoritative.",
    "All routes are temporarily modeled as homogeneous cycle1_standard parcel-delivery XL-van slots until richer route mix data arrives.",
    "This payload carries explicit Sunday-start operational scope even though the repo PlanningWeekID remains ISO-based."
  ],
  "planning_policy": {
    "heuristic_rolling7_caps_are_soft": true,
    "heuristic_weekly_caps_are_soft": true,
